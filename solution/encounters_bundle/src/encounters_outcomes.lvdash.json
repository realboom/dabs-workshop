                    {
                      "expression": "COUNT(`encounter_id`)",
                      "name": "count(encounter_id)"
                    },
                    {
                      "expression": "`region`",
                      "name": "region"
                    }
                  ]
                }
              }
            ],
            "spec": {
              "encodings": {
                "color": {
                  "displayName": "Region",
                  "fieldName": "region",
                  "scale": {
                    "type": "categorical"
                  }
                },
                "x": {
                  "displayName": "Month",
                  "fieldName": "monthly(admit_date)",
                  "scale": {
                    "type": "temporal"
                  }
                },
                "y": {
                  "displayName": "Encounters",
                  "fieldName": "count(encounter_id)",
                  "scale": {
                    "type": "quantitative"
                  }
