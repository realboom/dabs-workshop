            "spec": {
              "encodings": {
                "columns": [
                  {
                    "displayName": "Provider",
                    "fieldName": "provider_name"
                  },
                  {
                    "displayName": "Specialty",
                    "fieldName": "specialty"
                  },
                  {
                    "displayName": "Facility",
                    "fieldName": "facility_name"
                  },
                  {
                    "displayName": "Encounters",
                    "fieldName": "count(encounter_id)"
                  },
                  {
                    "displayName": "Readmit %",
                    "fieldName": "avg(readmit_pct)"
