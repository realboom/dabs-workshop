        {
          "position": {
            "height": 1,
            "width": 6,
            "x": 0,
            "y": 0
          },
          "widget": {
            "multilineTextboxSpec": {
              "lines": [
                "# Analyst 101 Workshop - Encounters & Outcomes"
              ]
            },
            "name": "title"
          }
        },
        {
          "position": {
            "height": 1,
            "width": 6,
            "x": 0,
            "y": 1
          },
          "widget": {
            "multilineTextboxSpec": {
              "lines": [
                "Synthetic medical encounters (no PHI). Aggregate by provider and facility, trend over time, drill into outcomes."
              ]
            },
            "name": "subtitle"
          }
        },
        {
          "position": {
            "height": 3,
            "width": 2,
            "x": 0,
            "y": 2
          },
          "widget": {
            "name": "kpi-encounters",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "encounters",
                  "disaggregated": false,
                  "fields": [
                    {
                      "expression": "COUNT(`encounter_id`)",
                      "name": "count(encounter_id)"
                    }
                  ]
                }
              }
            ],
            "spec": {
              "encodings": {
                "value": {
                  "displayName": "Total encounters",
                  "fieldName": "count(encounter_id)"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Total encounters"
              },
              "version": 2,
              "widgetType": "counter"
            }
          }
        },
